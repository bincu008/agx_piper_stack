#!/usr/bin/env python3
"""Submit calculation-only microsteps to the master and wait for completion."""

import argparse
import json
from pathlib import Path

from my_actions.action import RunPipelineSteps
from my_actions.srv import ClearStepContext, GetStepContext, SubmitPipelineSteps

import rclpy
from rclpy.action import ActionClient
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import PointCloud2
import time

from task_pipeline.recipes import (cup_to_tray, grasp_and_lift, prepare_grasp_lift, step,
                                   prepare_pick_place, execute_cached_pick_place, pick_and_place)
from my_actions.srv import PreparedGraspLift, PreparePickPlace
from task_pipeline.registry import FUNCTIONS
from task_pipeline.recipes import with_active_memory
from task_pipeline.preparation_recovery import retry_preparation
from rclpy.serialization import deserialize_message


def main():
    """Run a declarative cup grasp/placement calculation without hardware commands."""
    parser = argparse.ArgumentParser()
    parser.add_argument('--object', default='brown cup')
    parser.add_argument('--destination', default='tray')
    parser.add_argument('--grasp-only', action='store_true')
    parser.add_argument('--fresh-perception', action='store_true',
                        help='Bypass active target reuse and run the original perception recipe')
    execution_group = parser.add_mutually_exclusive_group()
    execution_group.add_argument('--queue-grasp-lift', action='store_true',
                                 help='Plan and queue all stages; pause before physical motion')
    execution_group.add_argument('--queue-pick-place', action='store_true',
                                 help='Plan all pick/place stages and pause before physical motion')
    execution_group.add_argument('--prepare-grasp-lift', action='store_true',
                                 help='Validate and cache all grasp/lift paths without motion')
    execution_group.add_argument('--check-cached-grasp-lift', action='store_true',
                                 help='Check cached plan and starting feedback without actuation')
    execution_group.add_argument('--execute-grasp-lift', action='store_true',
                        help='Physical trial: refined grasp and lift, then stop holding')
    execution_group.add_argument('--execute-cached-grasp-lift', action='store_true',
                                 help='Execute the reviewed cached grasp, then stop after lift')
    execution_group.add_argument('--prepare-pick-place', action='store_true', help='Preview all pick/place paths without motion')
    execution_group.add_argument('--check-cached-pick-place', action='store_true', help='Validate reviewed pick/place readiness without actuation')
    execution_group.add_argument('--execute-cached-pick-place', action='store_true', help='Execute reviewed grasp/lift/transfer/descent/release')
    parser.add_argument('--preparation-attempts', type=int, choices=range(1, 4), default=1,
                        help='Bounded fresh-observation retries for calculation-only preparation')
    parser.add_argument('--lift-distance', type=float, default=.05)
    parser.add_argument('--output', type=Path)
    parser.add_argument('--placement-policy', choices=('auto', 'edge', 'stack', 'floor_slots'), default='floor_slots')
    parser.add_argument('--obstacle-cloud-topic',
                        help='Freeze this base_link simulation cloud before running the recipe')
    args = parser.parse_args()
    execute_lift = args.execute_grasp_lift or args.execute_cached_grasp_lift
    execute_place = args.execute_cached_pick_place
    rclpy.init()
    node = rclpy.create_node('pipeline_task_client')
    try:
        obstacles = None
        if args.obstacle_cloud_topic:
            received = []
            subscription = node.create_subscription(
                PointCloud2, args.obstacle_cloud_topic, received.append,
                QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                           durability=DurabilityPolicy.TRANSIENT_LOCAL))
            deadline = time.monotonic() + 15
            while not received and time.monotonic() < deadline:
                rclpy.spin_once(node, timeout_sec=0.1)
            node.destroy_subscription(subscription)
            if not received or not received[-1].width:
                raise RuntimeError('No nonempty obstacle cloud received')
            obstacles = received[-1]
            if obstacles.header.frame_id != 'base_link':
                raise RuntimeError('Obstacle cloud must already be in base_link')
        client = node.create_client(SubmitPipelineSteps, '/pipeline/submit_steps')
        if not client.wait_for_service(timeout_sec=15):
            raise RuntimeError('Shared pipeline API unavailable')
        # Exclude ROS startup/input discovery, but include recipe construction,
        # submission, action setup, execution and final result delivery.
        client_started = time.monotonic()
        if (execute_lift or execute_place or args.prepare_grasp_lift or args.prepare_pick_place or args.queue_pick_place) and (args.grasp_only or obstacles is not None):
            raise ValueError('Physical lift trial cannot use simulation obstacles or grasp-only')
        attempts = []
        maximum_attempts = args.preparation_attempts if (args.prepare_grasp_lift or args.prepare_pick_place) else 1
        for attempt in range(1, maximum_attempts + 1):
            if args.queue_pick_place:
                recipe = pick_and_place(args.object, args.destination, args.lift_distance, args.placement_policy)
            elif args.prepare_pick_place:
                recipe = prepare_pick_place(args.object, args.destination, args.lift_distance, args.placement_policy)
            elif execute_place:
                recipe = execute_cached_pick_place(args.object, args.destination, args.placement_policy)
            elif args.check_cached_pick_place:
                recipe = [step('check_motion', 'validate_prepared_pick_place', PreparePickPlace.Request(object_name=args.object))]
            elif args.queue_grasp_lift:
                recipe = grasp_and_lift(args.object, args.lift_distance)
            elif args.prepare_grasp_lift:
                recipe = prepare_grasp_lift(args.object, args.lift_distance)
            elif args.check_cached_grasp_lift:
                recipe = [step('check_motion', 'validate_prepared_grasp_lift',
                               PreparedGraspLift.Request(object_name=args.object))]
            elif execute_lift:
                recipe = grasp_and_lift(args.object, args.lift_distance,
                                        use_cached=args.execute_cached_grasp_lift)
            else:
                recipe = cup_to_tray(args.object, args.destination, not args.grasp_only,
                                     obstacles, args.placement_policy)
            if not args.fresh_perception and not (execute_lift or execute_place or
                    args.check_cached_grasp_lift or args.check_cached_pick_place or obstacles is not None):
                recipe = with_active_memory(recipe, args.object, args.destination)
            future = client.call_async(SubmitPipelineSteps.Request(steps=recipe))
            rclpy.spin_until_future_complete(node, future, timeout_sec=30)
            if not future.done() or not future.result().success:
                raise RuntimeError('Submit failed' if not future.done() else future.result().status)
            context_id = future.result().context_id
            print('Master context:', context_id, flush=True)
            action = ActionClient(node, RunPipelineSteps, '/pipeline/run_steps')
            if not action.wait_for_server(timeout_sec=10):
                raise RuntimeError('Run action unavailable')
            goal = action.send_goal_async(
                RunPipelineSteps.Goal(context_id=context_id,
                                      stop_before_step_id='pregrasp' if (args.queue_grasp_lift or args.queue_pick_place) else ''),
                feedback_callback=lambda feedback: print(
                    feedback.feedback.step_id, feedback.feedback.status, flush=True))
            rclpy.spin_until_future_complete(node, goal, timeout_sec=15)
            handle = goal.result()
            if not handle.accepted:
                raise RuntimeError('Run rejected')
            completed = handle.get_result_async()
            rclpy.spin_until_future_complete(node, completed, timeout_sec=900)
            if not completed.done():
                handle.cancel_goal_async()
                raise TimeoutError('Pipeline completion timeout; backend state may be unknown')
            result = completed.result().result
            attempt_data = {
                'attempt': attempt, 'context_id': context_id,
                'success': result.success, 'seconds': result.wall_seconds,
                'steps': [{'id': item.step_id, 'function': item.function_name,
                           'success': item.success, 'status': item.status,
                           'seconds': item.wall_seconds} for item in result.results]}
            requests_by_step = {step.step_id: step for step in recipe}
            for row, item in zip(attempt_data['steps'], result.results):
                if item.function_name in ('verify_presence', 'ground_object'):
                    schema = FUNCTIONS[item.function_name].service_type
                    request = deserialize_message(
                        bytes(requests_by_step[item.step_id].request_cdr), schema.Request)
                    row['target'] = request.target
                    if item.response_cdr:
                        response = deserialize_message(bytes(item.response_cdr), schema.Response)
                        row['inference_response'] = response.text
                    print(f"[ROBOBRAIN API] step={item.step_id} function={item.function_name} "
                          f"target={request.target!r} seconds={item.wall_seconds:.6f} "
                          f"response={row.get('inference_response', '')!r}", flush=True)
            attempts.append(attempt_data)
            if not retry_preparation(result, attempt, maximum_attempts):
                break
            cleanup = node.create_client(ClearStepContext, '/pipeline/clear_step_context')
            released = cleanup.call_async(ClearStepContext.Request(context_id=context_id))
            rclpy.spin_until_future_complete(node, released, timeout_sec=10)
            if not released.done() or not released.result().success:
                raise RuntimeError('Failed preparation context could not be released')
            node.destroy_client(cleanup)
            action.destroy()
            print(f'[PREPARATION RECOVERY] attempt={attempt} failed; capturing fresh RGB-D',
                  flush=True)
        client_seconds = time.monotonic() - client_started
        inspector = node.create_client(GetStepContext, '/pipeline/get_step_context')
        snapshot = inspector.call_async(GetStepContext.Request(context_id=context_id))
        rclpy.spin_until_future_complete(node, snapshot, timeout_sec=10)
        if not snapshot.done() or not snapshot.result().success:
            raise RuntimeError('Could not inspect actual master task queue')
        queue_state = json.loads(snapshot.result().state_json)[0]
        data = {'context_id': context_id, 'success': result.success, 'status': result.status,
                'client_wall_seconds': client_seconds,
                'client_timing_scope': 'submission through final action result delivery',
                'additional_obstacle_points': obstacles.width * obstacles.height if obstacles else 0,
                'obstacle_cloud_topic': args.obstacle_cloud_topic,
                'placement_policy': args.placement_policy,
                'execution_mode': 'physical_pick_place' if execute_place else 'physical_grasp_lift' if execute_lift else 'calculation',
                'seconds': sum(item['seconds'] for item in attempts),
                'attempts': attempts,
                'steps': attempts[-1]['steps'],
                'task_pipeline': queue_state}
        for item in result.results:
            if item.function_name == 'get_execution_state' and item.success and item.response_cdr:
                from rosidl_runtime_py.convert import message_to_ordereddict
                state = deserialize_message(bytes(item.response_cdr), FUNCTIONS['get_execution_state'].service_type.Response)
                data['execution_state'] = dict(message_to_ordereddict(state))
        print(json.dumps(data, indent=2), flush=True)
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            args.output.write_text(json.dumps(data, indent=2) + '\n')
        return 0 if result.success else 1
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    raise SystemExit(main())
