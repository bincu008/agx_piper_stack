# GPD configuration for the Piper parallel-jaw gripper.
hand_geometry_filename = @GPD_VENDOR_SHARE@/config/piper_hand_geometry.cfg
image_geometry_filename = @GPD_VENDOR_SHARE@/config/image_geometry_15channels.cfg
weights_file = @GPD_VENDOR_SHARE@/models/lenet/15channels/params/

voxelize = 1
voxel_size = 0.003
remove_outliers = 0
workspace = -0.8 0.8 -0.8 0.8 -0.4 0.8
sample_above_plane = 0
# The cup handle is approximately 10 mm thick.  A 20 mm neighborhood mixes
# opposite and corner surfaces; three 3 mm voxels preserve each local face.
normals_radius = 0.009
refine_normals_k = 0

num_samples = 300
num_threads = 4
nn_radius = 0.02
num_orientations = 8
num_finger_placements = 10
# Evaluate closing directions around two independent hand axes.  Using only
# axis 2 biases the proposals toward one jaw orientation in the camera view.
hand_axes = 0 2
deepen_hand = 1
friction_coeff = 20
min_viable = 6

# The Piper gripper can close to zero.  Keep this above the 3 mm voxel size,
# but low enough to represent thin handles instead of forcing wide grasps.
min_aperture = 0.005
max_aperture = 0.100
workspace_grasps = -0.8 0.8 -0.8 0.8 -0.4 0.8
filter_approach_direction = 0
direction = 1 0 0
thresh_rad = 2.0

min_inliers = 0
num_selected = 300
batch_size = 1
min_score = 0
remove_plane_before_image_calculation = 0

plot_normals = 0
plot_samples = 0
plot_candidates = 0
plot_filtered_candidates = 0
plot_valid_grasps = 0
plot_clustered_grasps = 0
plot_selected_grasps = 0
