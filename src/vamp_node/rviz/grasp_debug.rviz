Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.35
    Cell Size: 0.1
    Class: rviz_default_plugins/Grid
    Color: 120; 120; 120
    Enabled: false
    Name: Ground Grid
    Plane: XY
    Reference Frame: base_link
  - Class: rviz_default_plugins/TF
    Enabled: true
    Frame Timeout: 15
    Frames:
      All Enabled: false
      base_link:
        Value: true
      calibrated_camera_frame:
        Value: true
    Marker Scale: 0.18
    Name: Base and Camera Origins
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Update Interval: 0
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 170; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: Object Point Cloud
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.006
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /vamp_planner/object_world
    Use Fixed Frame: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 120; 255
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: Destination Point Cloud
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.004
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /placement/destination_cloud
    Use Fixed Frame: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Floor Slots - Green Selected Orange Occupied
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /placement/floor_slots
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: 1 Grasp Endpoint
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pipeline/prepared_grasp
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: 3 Placement Endpoint
    Namespaces: {}
    Queue Size: 10
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pipeline/prepared_placement
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: 2 Lift Endpoint
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pipeline/prepared_lift
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Release Withdrawal Endpoint
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pipeline/prepared_withdrawal
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: 4 Tray View Retreat Endpoint
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pipeline/next_view_endpoint
  - Alpha: 0.25
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 210; 210; 210
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: Requested Slot Object - Grey
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.003
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pipeline/prepared_nominal_object_cloud
    Use Fixed Frame: true
  - Alpha: 0.8
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 50; 255; 255
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: Actual Placed Object - Cyan
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: true
    Size (Pixels): 5
    Size (m): 0.005
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pipeline/prepared_placed_object_cloud
    Use Fixed Frame: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: false
    Name: Arm Collision Spheres - Optional
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /vamp_debug/current_collision_spheres
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.3
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.25
      Name: Current View
      Pitch: 0.45
      Target Frame: base_link
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
