std_msgs/Header observation_header
sensor_msgs/Image destination_mask
string orientation_policy
string object_name
string destination_name
# Optional frozen synthetic/static obstacles in base_link; never replace the observation.
sensor_msgs/PointCloud2 additional_obstacles
# auto permits floor/stack; stack searches all exposed heightmap supports.
string support_mode
# Reserved deprecated fields; ignored. No named-support policy.
string support_name
sensor_msgs/PointCloud2 stack_support_cloud
