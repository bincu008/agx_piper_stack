  {
    "name": "check_freshness",
    "description": "Read a Boolean fresh result for the current image, named object, single current grasp pool, or prepared plan. No capture, inference, motion or uncertainty reset. Missing/unverified evidence is false. Source age and existing shorter backend checks both apply. Execution readiness is not certified.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string",
          "enum": [
            "image",
            "object",
            "grasp_pool",
            "plan"
          ],
          "description": "image uses current RGB-D metadata; object requires object_name; grasp_pool checks single current grasp pool; plan checks current prepared plan. This does not authorize execution."
        },
        "object_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Exact remembered name, required for object."
