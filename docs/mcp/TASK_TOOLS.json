  {
    "name": "plan_camera_view",
    "description": "Calculate only; never move. relative requires frame=camera_optical, translation_m=[right,down,forward], rotation_rad=[roll,pitch,yaw]. Delegates loose get_observe_view endpoint checking; PARTIAL/fallback does not prove a safe full path. target requires exactly one target_name or target_cell_id, rejects frame/both vectors, and uses plan_next_best_view. relative rejects target selectors. Supply request_id and mode on every call. Read result.status and achieved_fraction: NO_REACHABLE_CHANGE with 0.0 means no changed viewpoint was found.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Unique ID for a NEW task. Retry identical inputs with this same ID to find the same task; never replay unknown work with a new ID."
        },
        "mode": {
          "type": "string",
          "enum": [
            "relative",
            "target"
          ],
          "description": "relative: supply frame and both vectors, no target selectors. target: supply exactly one target_name or target_cell_id, no relative fields."
        },
        "translation_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 0.2
          },
          "description": "Required in relative mode only: camera-optical [right,down,forward] metres; vector norm <=0.20m. Use [0,0,0] for rotation only."
        },
        "rotation_rad": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          },
          "description": "Required in relative mode only: [roll,pitch,yaw] radians, each within +/-pi. Use [0,0,0] for translation only."
        },
        "frame": {
          "type": "string",
          "enum": [
            "camera_optical"
          ],
          "description": "Required in relative mode: camera_optical. Forbidden in target mode."
        },
        "target_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Target mode only: exact remembered target name. Supply this OR target_cell_id, never both."
        },
        "target_cell_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Target mode only: existing spatial cell ID. Supply this OR target_name, never both."
        },
        "camera_distance_m": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1.0,
          "default": 0.45,
          "description": "Optional target-view distance in metres; used only in target mode."
        },
        "wait_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 120,
          "default": 0,
          "description": "Optional bounded wait for this existing calculation; no polling loop."
        }
      },
      "required": [
        "request_id",
        "mode"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "success",
        "state",
        "status"
      ],
      "properties": {
        "success": {
          "type": "boolean"
