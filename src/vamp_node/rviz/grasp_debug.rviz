Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Trial Placement Candidates - Proposed Only
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /placement/trial_candidates
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Live Arm Collision Spheres and Indices
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vamp_debug/current_collision_spheres
    - Alpha: 0.35
      Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: base_link
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Prepared Grasp and Pregrasp
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pipeline/prepared_grasp
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        calibrated_camera_frame:
          Value: true
      Marker Scale: 0.18
      Name: Base and Camera Origins
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 210; 120
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: Obstacle Voxels
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.012
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /active_vision/global_map
      Use Fixed Frame: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 170; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Object Point Cloud
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.006
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vamp_planner/object_world
      Use Fixed Frame: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 40; 40
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Object Supporting Surface
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 7
      Size (m): 0.006
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /placement/artificial_bottom_cloud
      Use Fixed Frame: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Valid Grasp Candidate Pool
      Namespaces:
        {}
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vamp_planner/grasp_candidates_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Valid Grasps Before Ranking
      Namespaces:
        {}
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vamp_planner/valid_grasp_candidates_markers
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 120; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Destination Point Cloud
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.004
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /placement/destination_cloud
      Use Fixed Frame: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 120; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Box Benchmark Tray
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.004
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /box_benchmark/tray_cloud
      Use Fixed Frame: true
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 50; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Accepted Placement Object
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.005
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vamp_planner/refined_placed_object_cloud
      Use Fixed Frame: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 40
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Accepted Placement Supporting Surface
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 8
      Size (m): 0.007
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vamp_planner/refined_placed_support_surface
      Use Fixed Frame: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Placement End Effector
      Namespaces:
        {}
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /vamp_planner/placement_plan_markers
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Box Benchmark Scene
      Queue Size: 1
      Size (m): 0.004
      Style: Points
      Color Transformer: FlatColor
      Color: 190; 190; 190
      Position Transformer: XYZ
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /box_benchmark/boxes_cloud
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Box Benchmark Placements
      Namespaces: {}
      Queue Size: 1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /box_benchmark/placements
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Floor Slots - Green Selected Orange Occupied
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /placement/floor_slots
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.3
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.25
      Name: Current View
      Pitch: 0.45
      Target Frame: base_link
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
