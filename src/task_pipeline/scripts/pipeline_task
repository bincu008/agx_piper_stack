#!/usr/bin/env python3
"""Submit calculation-only microsteps to the master and wait for completion."""

import argparse
import json
from pathlib import Path

from my_actions.action import RunPipelineSteps
from my_actions.srv import SubmitPipelineSteps

import rclpy
from rclpy.action import ActionClient
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import PointCloud2
import time

from task_pipeline.recipes import cup_to_tray
from task_pipeline.registry import FUNCTIONS
from rclpy.serialization import deserialize_message


def main():
    """Run a declarative cup grasp/placement calculation without hardware commands."""
    parser = argparse.ArgumentParser()
    parser.add_argument('--object', default='brown cup')
    parser.add_argument('--destination', default='tray')
    parser.add_argument('--grasp-only', action='store_true')
    parser.add_argument('--output', type=Path)
    parser.add_argument('--placement-policy', choices=('auto', 'edge', 'stack', 'floor_slots'), default='floor_slots')
    parser.add_argument('--obstacle-cloud-topic',
                        help='Freeze this base_link simulation cloud before running the recipe')
    args = parser.parse_args()
    rclpy.init()
    node = rclpy.create_node('pipeline_task_client')
    try:
        obstacles = None
        if args.obstacle_cloud_topic:
            received = []
            subscription = node.create_subscription(
                PointCloud2, args.obstacle_cloud_topic, received.append,
                QoSProfile(depth=1, reliability=ReliabilityPolicy.RELIABLE,
                           durability=DurabilityPolicy.TRANSIENT_LOCAL))
            deadline = time.monotonic() + 15
            while not received and time.monotonic() < deadline:
                rclpy.spin_once(node, timeout_sec=0.1)
            node.destroy_subscription(subscription)
            if not received or not received[-1].width:
                raise RuntimeError('No nonempty obstacle cloud received')
            obstacles = received[-1]
            if obstacles.header.frame_id != 'base_link':
                raise RuntimeError('Obstacle cloud must already be in base_link')
        client = node.create_client(SubmitPipelineSteps, '/pipeline/submit_steps')
        if not client.wait_for_service(timeout_sec=15):
            raise RuntimeError('Shared pipeline API unavailable')
        # Exclude ROS startup/input discovery, but include recipe construction,
        # submission, action setup, execution and final result delivery.
        client_started = time.monotonic()
        recipe = cup_to_tray(
            args.object, args.destination, not args.grasp_only, obstacles,
            args.placement_policy)
        future = client.call_async(SubmitPipelineSteps.Request(steps=recipe))
        rclpy.spin_until_future_complete(node, future, timeout_sec=30)
        if not future.done() or not future.result().success:
            raise RuntimeError('Submit failed' if not future.done() else future.result().status)
        context_id = future.result().context_id
        print('Master context:', context_id, flush=True)
        action = ActionClient(node, RunPipelineSteps, '/pipeline/run_steps')
        if not action.wait_for_server(timeout_sec=10):
            raise RuntimeError('Run action unavailable')
        goal = action.send_goal_async(
            RunPipelineSteps.Goal(context_id=context_id),
            feedback_callback=lambda feedback: print(
                feedback.feedback.step_id, feedback.feedback.status, flush=True))
        rclpy.spin_until_future_complete(node, goal, timeout_sec=15)
        handle = goal.result()
        if not handle.accepted:
            raise RuntimeError('Run rejected')
        completed = handle.get_result_async()
        rclpy.spin_until_future_complete(node, completed, timeout_sec=900)
        if not completed.done():
            handle.cancel_goal_async()
            raise TimeoutError('Pipeline completion timeout; backend state may be unknown')
        result = completed.result().result
        client_seconds = time.monotonic() - client_started
        data = {'context_id': context_id, 'success': result.success, 'status': result.status,
                'client_wall_seconds': client_seconds,
                'client_timing_scope': 'submission through final action result delivery',
                'additional_obstacle_points': obstacles.width * obstacles.height if obstacles else 0,
                'obstacle_cloud_topic': args.obstacle_cloud_topic,
                'placement_policy': args.placement_policy,
                'seconds': result.wall_seconds,
                'steps': [{'id': item.step_id, 'function': item.function_name,
                           'success': item.success, 'status': item.status,
                           'seconds': item.wall_seconds} for item in result.results]}
        requests_by_step = {step.step_id: step for step in recipe}
        for row, item in zip(data['steps'], result.results):
            if item.function_name in ('verify_presence', 'ground_object'):
                schema = FUNCTIONS[item.function_name].service_type
                request = deserialize_message(
                    bytes(requests_by_step[item.step_id].request_cdr), schema.Request)
                row['target'] = request.target
                if item.response_cdr:
                    response = deserialize_message(bytes(item.response_cdr), schema.Response)
                    row['inference_response'] = response.text
                print(f"[ROBOBRAIN API] step={item.step_id} function={item.function_name} "
                      f"target={request.target!r} seconds={item.wall_seconds:.6f} "
                      f"response={row.get('inference_response', '')!r}", flush=True)
        print(json.dumps(data, indent=2), flush=True)
        if args.output:
            args.output.write_text(json.dumps(data, indent=2) + '\n')
        return 0 if result.success else 1
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    raise SystemExit(main())
